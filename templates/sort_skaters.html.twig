{% extends "base.html.twig" %}

{% block title %}Les skaters selon leur trick favori{% endblock %}

{% block body %}

    <div class="card mb-4">
        <div class="card-body">
            {{ form(form) }}
        </div>
    </div>

    <div class="skaters-section text-center">
        <div class="row g-4 mt-2">
            {% for skater in skaters %}
                <div class="col-md-4">
                    <div class="card bg-secondary text-white h-100 border-0 shadow">
                        <div class="card-body">
                            <h5 class="card-title">{{ skater.fullName }}</h5>
                            <p class="card-text text-light opacity-75 small">Membre Officiel SLS</p>
                            <a href="{{ path('app_skater_detail', { id: skater.id }) }}" class="btn btn-outline-warning btn-sm">Voir le profil</a>
                        </div>
                    </div>
                </div>
            {% else %}
                <p class="text-muted">Aucun skater trouvé.</p>
            {% endfor %}
        </div>
    </div>

    <div class="text-center mt-4">
        <a href="{{ path('app_homepage') }}" class="small">← Retour à l'accueil</a>
    </div>

{% endblock %}
