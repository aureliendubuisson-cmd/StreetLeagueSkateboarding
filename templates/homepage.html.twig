<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%22%22 fill=%22%23fff%22>sf</text></svg>">
        
        {% block stylesheets %}
        {% endblock %}
        
        {% block javascripts %}
            {{ importmap('app') }}
        {% endblock %}
    </head>
    <body>
        {% block body %}
        <div class = "header">

            <h1>
                Top 5 of Street League Skateboarding!
            </h1>

        </div >
            <div class = "skaters">
                <h1>Les cinq skaters les plus prometteurs de l'année 2026! </h1>

                    {%  for skater in skaters %}

                        <h2> Name : </h2>
                        <p>{{ skater.name }}</p>


                        <h2>Nationality : </h2>
                        <p>{{ skater.nationality }}</p>


                        <h2>Birthyear : </h2>
                        <p>{{ skater.birthyear }}</p>


                        <h2>FavoriteTricks : </h2>
                        <p>{{ skater.favoriteTrick }}</p>


                        <h2>Win SLS : </h2>
                        <p>{{ skater.winSLS }}</p>

                        <br>

                    {% endfor %}

            </div>
        {% endblock %}
    </body>
</html>

