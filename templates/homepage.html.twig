{% extends 'base.html.twig' %}

        {% block body %}
            <nav>
                <h2>Voir les skaters selon leur trick préféré</h2>
                <ul>
                    <li><a href="{{ path('app_favorite_tricks', {tricks:"flip front"}) }}">Flip front</a></li>
                    <li><a href="{{ path('app_favorite_tricks', {tricks:"to roll"}) }}">To roll</a></li>
                    <li><a href="{{ path('app_favorite_tricks', {tricks:"dark slide"}) }}">Dark slide</a></li>
                    <li><a href="{{ path('app_favorite_tricks', {tricks:"slappy backside Boardslide"}) }}">Slappy boardslide</a></li>

                </ul>

                <h2>Voir les skaters selon leur age</h2>
                <ul>
                    <li><a href="{{ path('app_skaters_age', {age: 15}) }}">Moins de 15 ans</a></li>
                    <li><a href="{{ path('app_skaters_age', {age:30}) }}">Moins de 30 ans</a></li>


                </ul>

                <h2>Voir les skaters selon leur pays</h2>
                <ul>
                    <li><a href="{{ path('app_country', {country :"France"}) }}">France</a></li>
                    <li><a href="{{ path('app_country', {country :"Portugal"}) }}">Portugal</a></li>


                </ul>

            </nav>



            <div class = "skaters">
                <h1>Les cinq skaters les plus prometteurs de l'année 2026! </h1>

                    {%  for skater in skaters %}

                        <h2> Name : </h2>
                        <p>{{ skater.name }}</p>


                        <h2>Nationality : </h2>
                        <p>{{ skater.nationality }}</p>


                        <h2>Birthyear : </h2>
                        <p>{{ skater.birthyear }}</p>


                        <h2>FavoriteTricks : </h2>
                        <p>{{ skater.favoriteTrick }}</p>


                        <h2>Win SLS : </h2>
                        <p>{{ skater.winSLS }}</p>


                    {% endfor %}

            </div>

        {% endblock %}
