{% extends 'base.html.twig' %}

{% block body %}
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark rounded shadow-sm mb-5">
        <div class="container-fluid">
            <div class="collapse navbar-collapse" id="navbarNavDarkDropdown">
                <ul class="navbar-nav w-100 justify-content-around">

                    <li class="nav-item">
                        <a class="btn btn-warning fw-bold" href="{{ path('app_new_skater') }}">＋ NOUVEAU SKATER</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-white" href="{{ path('app_favorite_tricks') }}">TRICKS</a>
                    </li>

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle text-white" href="#" role="button" data-bs-toggle="dropdown">AGE</a>
                        <ul class="dropdown-menu dropdown-menu-dark">
                            <li><a class="dropdown-item" href="{{ path('app_skaters_age', {age: 15}) }}">Moins de 15 ans</a></li>
                            <li><a class="dropdown-item" href="{{ path('app_skaters_age', {age: 30}) }}">Moins de 30 ans</a></li>
                        </ul>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-white" href="{{ path('app_country') }}">PAYS</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="skaters-section text-center">
        <h2 class="mb-4 display-5 fw-bold section-title">PROMETTEURS 2026</h2>

        <div class="row g-4 mt-2">
            {% for skater in skaters %}
                <div class="col-md-4">
                    <div class="card bg-secondary text-white h-100 border-0 shadow">
                        <div class="card-body">
                            <h5 class="card-title">{{ skater.firstName }} {{ skater.lastName }}</h5>
                            <p class="card-text text-light opacity-75 small">Membre Officiel SLS</p>
                            <a href="{{ path('app_skater_detail',{ id: skater.id }) }}" class="btn btn-outline-warning btn-sm">Voir le profil</a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
