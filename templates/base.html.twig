<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}SLS 2026{% endblock %}</title>
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;700&display=swap" rel="stylesheet">

    {% block stylesheets %}{% endblock %}
    {% block javascripts %}{{ importmap('app') }}{% endblock %}
</head>
<body>

<header class="header-sls">
    <div class="container d-flex justify-content-between align-items-center">
        <h1 class="header-title m-0">Street League <span class="text-white">Skateboarding</span></h1>
        <img class="img-logo" alt="logo" src="{{ asset('img/2018_sls_seal.png') }}"/>
    </div>
</header>

<main class="container">
    {% block body %}{% endblock %}
</main>

<footer>
    {% block footer %}
        &copy; 2026 Street League Skateboarding (SLS) - Compétition Officielle
    {% endblock %}
</footer>

</body>
</html>
