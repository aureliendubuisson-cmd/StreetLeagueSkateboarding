{% extends "base.html.twig" %}

{% block title %}Les skaters selon leur age{% endblock %}

{% block body %}

    <h1>Les skaters de moins de {{ age }} :</h1>
    <ul>
        {%  for skater in skaters %}

            <li>{{ skater.name }}</li>
            <li>{{ skater.birthyear }}</li>

        {% endfor %}
        <li><a href="{{ path('app_homepage')}}">Return to the homepage</a></li>
    </ul>

{% endblock %}
