{% extends "base.html.twig" %}

{% block title %}Favorite trick: {{ tricks }}{% endblock %}

{% block body %}
    <div class="card bg-dark text-white p-4 border-warning">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="header-title">Spécialistes : {{ tricks|upper }}</h2>
            <a href="{{ path('app_homepage')}}" class="btn btn-sm btn-outline-warning">← Retour</a>
        </div>

        <div class="table-responsive">
            <table class="table table-dark table-hover">
                <thead>
                <tr>
                    <th>Nom Complet</th>
                    <th>Année de Naissance</th>
                    <th class="text-end">Action</th>
                </tr>
                </thead>
                <tbody>
                {% for skater in skaters %}
                    <tr>
                        <td class="fw-bold">{{ skater.getFullName() }}</td>
                        <td>{{ skater.birthyear }}</td>
                        <td class="text-end">
                            <span class="badge bg-warning text-dark">PRO</span>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="3" class="text-center text-muted">Aucun skater trouvé pour ce trick.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
